@startuml
!include ../_style.puml
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60
title Продажа билетов на стадион: модель предметной области
hide circle
package "sales" {
    abstract class Сотрудник {
        + табельныйНомер : String
        + фио : String
    }
    class Кассир {
        + номерОкна : int
    }
    class Администратор {
        + уровеньДоступа : int
    }
    class Покупатель {
        + фио : String
        + контактныеДанные : String
    }
    class Касса {
        + номер : String
        + инициироватьБлокировку() : void
    }
    class Заказ {
        + номер : String
        + дата : DateTime
        + зафиксироватьПродажу() : void
    }
    class Возврат {
        + датаОформления : DateTime
        + комиссия : Money
        + оформитьОтмену() : void
    }
    class Блокировка <<association class>> {
        + времяНачала : DateTime
        + таймер : int
    }
    Кассир --|> Сотрудник
    Администратор --|> Сотрудник
    Покупатель "1" -- "0..*" Заказ
    Сотрудник "1" -- "0..*" Заказ
    Администратор "1" -- "0..*" Возврат
}
package "catalog" {
    class Событие {
        + название : String
        + датаВремя : DateTime
    }
    enum СтатусМеста {
        СВОБОДНО
        ЗАБЛОКИРОВАНО
        ВЫКУПЛЕНО
    }
    class Место {
        + ряд : int
        + номер : String
        + статус : СтатусМеста
    }
    class Билет {
        + штрихкод : String
        + цена : Money
    }
    class Абонемент {
        + срокДействия : Date
        + цена : Money
    }
    Событие "1" o-- "0..*" Билет
    Событие "1..*" -- "0..*" Абонемент
    Билет "0..1" -- "1" Место
}
sales ..> catalog : <<use>>
Касса "1" -- "0..*" Место
(Касса, Место) .. Блокировка
Заказ "1" *-- "1..*" Билет
Заказ "1" *-- "0..*" Абонемент
Возврат "0..1" -- "1" Билет

@enduml